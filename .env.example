# Copy to .env.local (or .env) and fill in. Never commit real values.
# Supabase → Project Settings → API Keys

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). The legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. NEVER put a secret/service_role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: protects /api/keepalive (step 9). Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Web Push (iPhone notifications while the app is closed) ---
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Server-only secret key (sb_secret_…) used by /api/push/tick. NEVER in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
